<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DLP Generator — IIS Malaysia</title>
<link rel="stylesheet" href="https://d2z0o16i8xm8ak.cloudfront.net/ask-engine/direct-files/202c5e9284e1f758a62d103fdb95d434/696d188b-a46f-4474-b62e-824ec0ec08ef/style.css">


</head>
<body>

<div class="app-shell">
  <header class="app-header">
    <h1>Daily Lesson Plan Generator</h1>
    <p class="subtitle">International Islamic School Malaysia (Secondary) — no sheet needed, everything is on this page</p>
  </header>

  <section class="controls">
    <div class="controls-grid">

      <div class="field">
        <label for="semesterSelect">Semester</label>
        <select id="semesterSelect">
          <option value="">Select semester</option>
          <option value="1">Semester 1</option>
          <option value="2">Semester 2</option>
        </select>
      </div>

      <div class="field">
        <label for="teacherSelect">Teacher</label>
        <select id="teacherSelect">
          <option value="">Select teacher</option>
        </select>
      </div>

      <div class="field">
        <label for="coordinatorSelect">Coordinator</label>
        <select id="coordinatorSelect">
          <option value="">Select coordinator</option>
        </select>
      </div>

      <div class="field">
        <label for="subjectSelect">Subject</label>
        <select id="subjectSelect">
          <option value="">Select subject</option>
        </select>
      </div>

      <div class="field">
        <label for="classSelect">Class</label>
        <select id="classSelect">
          <option value="">Select class</option>
        </select>
      </div>

      <div class="field">
        <label for="weekSelect">Week (1–18)</label>
        <select id="weekSelect">
          <option value="">Select week</option>
        </select>
      </div>

      <div class="field field-wide">
        <label>Teaching days <span class="hint">pick up to 3</span></label>
        <div class="days-row" id="daysRow"></div>
      </div>

      <div class="field field-wide">
        <label for="topicInput">Topic &amp; Subtopics</label>
        <input type="text" id="topicInput" placeholder="e.g. Introduction to Islamic Studies: Syllabus, Past Papers…">
      </div>

      <div class="field field-wide">
        <label for="objectivesInput">Objectives <span class="hint">(one per line)</span></label>
        <textarea id="objectivesInput" rows="4" placeholder="By the end of the lesson, students will be able to…"></textarea>
      </div>

      <div class="field field-wide">
        <label for="activitiesInput">Teaching &amp; Learning Activities <span class="hint">(one per line)</span></label>
        <textarea id="activitiesInput" rows="4" placeholder="- Begin with salām, du'ā, and…"></textarea>
      </div>

      <div class="field field-wide">
        <label for="resourcesPicker">Resources <span class="hint">(tick all that apply)</span></label>
        <div class="picker-box" id="resourcesPicker"></div>
      </div>

      <div class="field field-wide">
        <label for="assessmentsPicker">Assessments <span class="hint">(tick all that apply)</span></label>
        <div class="picker-box" id="assessmentsPicker"></div>
      </div>

    </div>

    <div class="field-actions">
      <button id="previewBtn" type="button">Preview</button>
      <button id="pdfBtn" type="button" disabled="">Download PDF</button>
      <button id="pngBtn" type="button" disabled="">Download PNG</button>
    </div>
  </section>

  <p class="status" id="statusMsg">Fill in the form, then click Preview.</p>

  <section class="preview-wrap">
    <div class="dlp-table-outer" id="dlpTable">

      <table class="dlp-table">
        <colgroup>
          <col style="width:9%">
          <col style="width:16%">
          <col style="width:20%">
          <col style="width:29%">
          <col style="width:15%">
          <col style="width:11%">
        </colgroup>

        <thead>
          <tr class="header-row">
            <th colspan="6" class="title-cell">
              <div class="title-flex">
                <div class="logo-slot"><img src="https://d2z0o16i8xm8ak.cloudfront.net/ask-engine/direct-files/202c5e9284e1f758a62d103fdb95d434/696d188b-a46f-4474-b62e-824ec0ec08ef/logo.png" alt="School logo" id="logoImg" style="visibility: hidden;"></div>
                <div class="title-text">
                  <div class="school-name">INTERNATIONAL ISLAMIC SCHOOL MALAYSIA (SECONDARY)</div>
                  <div class="dlp-name">DAILY LESSON PLAN 2026-2027 (<span id="titleSemester">SEMESTER 1</span>)</div>
                  <div class="member-line">Member of International Islamic University Malaysia</div>
                </div>
              </div>
            </th>
          </tr>
          <tr class="meta-row">
            <td colspan="2"><strong>Subject:</strong> <span id="metaSubject">—</span></td>
            <td colspan="2"><strong>Grade:</strong> <span id="metaClass">—</span></td>
            <td colspan="2"><strong>Week:</strong> <span id="metaWeek">—</span></td>
          </tr>
          <tr class="col-head-row">
            <th>DAY &amp; DATE</th>
            <th>TOPIC &amp; SUBTOPICS</th>
            <th>OBJECTIVES</th>
            <th>TEACHING &amp; LEARNING ACTIVITIES</th>
            <th>RESOURCES</th>
            <th>ASSESSMENTS</th>
          </tr>
        </thead>

        <tbody id="dlpBody">
          <!-- rows injected by app.js -->
        </tbody>
      </table>

      <div class="sign-row">
        <div class="sign-block">
          <div class="sign-label">Prepared by:</div>
          <div class="sign-line"></div>
          <div class="sign-name" id="signTeacher">Teacher Name</div>
        </div>
        <div class="sign-block">
          <div class="sign-label">Checked by:</div>
          <div class="sign-line"></div>
          <div class="sign-name" id="signCoordinator">Coordinator</div>
        </div>
      </div>

    </div>
  </section>
</div>




</body></html>
